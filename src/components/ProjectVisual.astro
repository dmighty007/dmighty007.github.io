---
interface Props {
  variant: 'pathgennie' | 'icecoder' | 'kinetics' | 'trails';
}
const { variant } = Astro.props;
---

<div class={`project-visual pv-${variant}`}>
  {
    variant === 'pathgennie' && (
      <svg viewBox="0 0 300 200" aria-hidden="true" focusable="false">
        <g class="ghost-paths">
          <path d="M 30 160 C 90 150, 130 130, 160 100" />
          <path d="M 30 160 C 80 170, 140 160, 190 120" />
        </g>
        <path class="guided-path" d="M 30 160 C 100 120, 150 60, 260 40" />
        <circle class="node start" cx="30" cy="160" r="5" />
        <circle class="node end" cx="260" cy="40" r="5" />
        <circle class="walker" r="3.5" />
      </svg>
    )
  }
  {
    variant === 'icecoder' && (
      <svg viewBox="0 0 300 200" aria-hidden="true" focusable="false">
        <g class="cluster cluster-a">
          <circle cx="80" cy="70" r="4" /><circle cx="95" cy="55" r="3" /><circle cx="65" cy="90" r="3" />
          <circle cx="100" cy="90" r="3.5" /><circle cx="75" cy="50" r="3" /><circle cx="55" cy="70" r="3" />
        </g>
        <g class="cluster cluster-b">
          <circle cx="210" cy="130" r="4" /><circle cx="225" cy="115" r="3" /><circle cx="195" cy="145" r="3" />
          <circle cx="230" cy="150" r="3.5" /><circle cx="200" cy="115" r="3" /><circle cx="240" cy="130" r="3" />
        </g>
        <path class="boundary" d="M 150 20 C 130 70, 170 130, 150 180" />
      </svg>
    )
  }
  {
    variant === 'kinetics' && (
      <svg viewBox="0 0 300 200" aria-hidden="true" focusable="false">
        <circle class="node" cx="30" cy="100" r="5" />
        <path class="channel channel-1" d="M 30 100 C 100 40, 180 40, 260 55" />
        <path class="channel channel-2" d="M 30 100 C 110 100, 180 100, 260 100" />
        <path class="channel channel-3" d="M 30 100 C 100 160, 180 160, 260 145" />
        <circle class="node" cx="260" cy="55" r="4" />
        <circle class="node" cx="260" cy="100" r="4" />
        <circle class="node" cx="260" cy="145" r="4" />
      </svg>
    )
  }
  {
    variant === 'trails' && (
      <svg viewBox="0 0 300 200" aria-hidden="true" focusable="false">
        <g class="lineage">
          <path d="M 40 180 L 40 120" />
          <path d="M 40 120 L 100 90" />
          <path d="M 40 120 L 100 150" />
          <path d="M 100 90 L 170 60" />
          <path d="M 100 90 L 170 110" />
          <path d="M 100 150 L 170 170" />
          <path d="M 170 60 L 250 45" />
          <path d="M 170 110 L 250 100" />
        </g>
        <circle class="node root" cx="40" cy="180" r="5" />
        <circle class="node" cx="170" cy="60" r="3.5" /><circle class="node" cx="170" cy="110" r="3.5" /><circle class="node" cx="170" cy="170" r="3.5" />
        <circle class="node" cx="250" cy="45" r="3.5" /><circle class="node" cx="250" cy="100" r="3.5" />
      </svg>
    )
  }
</div>

<style>
  .project-visual {
    width: 100%;
    max-width: 22rem;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ghost-paths path {
    fill: none;
    stroke: var(--color-text-tertiary);
    stroke-width: 1;
    opacity: 0.3;
  }

  .guided-path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
  }

  .node {
    fill: var(--color-text);
    opacity: 0.6;
  }

  .node.start {
    fill: var(--color-text-tertiary);
  }

  .node.end,
  .node.root {
    fill: var(--color-accent);
    opacity: 1;
  }

  .walker {
    fill: var(--color-accent);
    opacity: 0;
  }

  .cluster circle {
    fill: var(--color-accent);
  }

  .cluster-a circle {
    opacity: 0.5;
  }

  .cluster-b circle {
    opacity: 0.85;
  }

  .boundary {
    fill: none;
    stroke: var(--color-text-tertiary);
    stroke-width: 1;
    stroke-dasharray: 4 5;
    opacity: 0.5;
  }

  .channel {
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .channel-1 {
    stroke: var(--color-accent);
    opacity: 0.9;
  }

  .channel-2 {
    stroke: var(--color-text-tertiary);
    opacity: 0.55;
  }

  .channel-3 {
    stroke: var(--color-text-tertiary);
    opacity: 0.35;
  }

  .lineage path {
    fill: none;
    stroke: var(--color-text-tertiary);
    stroke-width: 1.25;
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pv-pathgennie .guided-path {
      transition: stroke-dashoffset 1.6s var(--ease-standard);
    }
    .pv-pathgennie.in-view .guided-path {
      stroke-dashoffset: 0;
    }

    .pv-pathgennie .walker {
      offset-path: path('M 30 160 C 100 120, 150 60, 260 40');
      animation: pv-walk 4.5s ease-in-out 1.6s infinite;
    }

    @keyframes pv-walk {
      0% { offset-distance: 0%; opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-pathgennie .guided-path {
      stroke-dashoffset: 0;
    }
    .pv-pathgennie .walker {
      display: none;
    }
  }
</style>

<script>
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    document.querySelectorAll('.pv-pathgennie').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.pv-pathgennie').forEach((el) => el.classList.add('in-view'));
  }
</script>
