---
import HeroCarousel from './HeroCarousel.astro';
import { profile } from '../data/profile';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text reveal is-visible">
      <p class="eyebrow">{profile.tagline}</p>
      <h1>{profile.name}</h1>
      <p class="hero-statement">{profile.statement}</p>
      <ul class="hero-facts">
        <li>Ph.D. in Physics (Theoretical) — {profile.affiliation}</li>
        <li>Ph.D. thesis submitted</li>
        <li>{profile.availability}</li>
      </ul>
      <div class="hero-actions">
        <a href="/research" class="btn btn-primary">Explore Research</a>
        <a href="/publications" class="btn">View Publications</a>
      </div>
      <div class="hero-secondary">
        <a href={profile.links.cv} class="btn-ghost btn">Download CV</a>
        <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer" class="btn-ghost btn">Google Scholar</a>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="btn-ghost btn">GitHub</a>
        <a href={`mailto:${profile.email}`} class="btn-ghost btn">Email</a>
      </div>
    </div>
    <div class="hero-visual-wrap reveal is-visible">
      <HeroCarousel />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  h1 {
    font-size: clamp(2.25rem, 1.7rem + 2.3vw, 3.5rem);
    margin-block: 0.3rem 1.1rem;
  }

  .hero-statement {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    color: var(--color-text-secondary);
    max-width: 46ch;
    line-height: 1.55;
  }

  .hero-facts {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    border-left: 2px solid var(--color-border-strong);
    padding-left: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 1.25rem;
  }

  .hero-secondary .btn {
    padding-inline: 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .hero-secondary .btn:hover {
    color: var(--color-accent);
    transform: none;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual-wrap {
      order: -1;
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
    }
  }
</style>
