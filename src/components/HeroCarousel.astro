---
// Rotating 3D showcase: a live free-energy-surface render and a real
// ligand-bound protein structure. Both are generated/rendered client-side
// (three.js + 3Dmol.js) rather than static images, so the hero reads as an
// active piece of scientific software rather than a picture of one.
---

<div class="hero-carousel" id="hero-carousel">
  <div class="carousel-stage">
    <div class="carousel-slide is-active" data-index="0">
      <div id="fes3d-stage" class="stage-canvas"></div>
    </div>
    <div class="carousel-slide" data-index="1">
      <div id="protein3d-stage" class="stage-canvas"></div>
    </div>
    <div class="stage-loading" id="stage-loading" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </div>

  <div class="carousel-caption">
    <span class="carousel-caption-index" id="carousel-caption-index">01</span>
    <span class="carousel-caption-text" id="carousel-caption-text">Free-energy landscape</span>
  </div>

  <button type="button" class="carousel-arrow carousel-prev" aria-label="Previous visualization">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
  </button>
  <button type="button" class="carousel-arrow carousel-next" aria-label="Next visualization">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
  </button>

  <div class="carousel-dots" role="tablist" aria-label="Visualization slides">
    <button type="button" class="carousel-dot is-active" data-index="0" role="tab" aria-selected="true" aria-label="Show free-energy landscape"></button>
    <button type="button" class="carousel-dot" data-index="1" role="tab" aria-selected="false" aria-label="Show protein–ligand structure"></button>
  </div>
</div>

<style>
  .hero-carousel {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 34rem;
    margin-inline: auto;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 60%),
      var(--color-bg-raised);
    border: 1px solid var(--color-border);
  }

  .carousel-stage {
    position: absolute;
    inset: 0;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  .carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .stage-canvas {
    width: 100%;
    height: 100%;
  }

  .stage-canvas :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  .stage-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .stage-loading.is-hidden {
    opacity: 0;
  }

  .stage-loading span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.4;
    animation: stage-pulse 1s ease-in-out infinite;
  }

  .stage-loading span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .stage-loading span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes stage-pulse {
    0%, 100% { transform: scale(1); opacity: 0.35; }
    50% { transform: scale(1.4); opacity: 0.9; }
  }

  .carousel-caption {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.8125rem;
    max-width: calc(100% - 1.8rem);
  }

  .carousel-caption-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .carousel-caption-text {
    color: var(--color-text-secondary);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard);
  }

  .hero-carousel:hover .carousel-arrow,
  .hero-carousel:focus-within .carousel-arrow {
    opacity: 1;
  }

  .carousel-arrow:hover {
    border-color: var(--color-accent);
  }

  .carousel-arrow svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .carousel-prev {
    left: 0.75rem;
  }

  .carousel-next {
    right: 0.75rem;
  }

  .carousel-dots {
    position: absolute;
    right: 0.3rem;
    bottom: 0.3rem;
    display: flex;
    gap: 0.1rem;
  }

  .carousel-dot {
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .carousel-dot::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-border-strong);
    transition: background-color var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard);
  }

  .carousel-dot.is-active::before {
    background: var(--color-accent);
    transform: scale(1.3);
  }

  @media (max-width: 900px) {
    .hero-carousel {
      max-width: 22rem;
    }
  }
</style>

<script src="../scripts/hero-carousel.ts"></script>
