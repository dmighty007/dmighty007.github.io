---
import { profile } from '../data/profile';
---

<section class="contact section-alt" id="contact">
  <div class="container contact-inner">
    <div class="contact-motif" aria-hidden="true">
      <svg viewBox="0 0 120 120" focusable="false">
        <path d="M 10 100 C 40 90, 60 60, 60 30 S 90 10, 110 12" />
        <circle cx="110" cy="12" r="4" />
      </svg>
    </div>
    <p class="eyebrow reveal">Get in touch</p>
    <h2 class="section-heading reveal">Research, collaboration, and postdoctoral opportunities</h2>
    <p class="section-lede reveal">{profile.availability}</p>

    <div class="contact-actions reveal">
      <a href={`mailto:${profile.email}`} class="btn btn-primary">{profile.email}</a>
      <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer" class="btn">Google Scholar</a>
      <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="btn">GitHub</a>
      <a href={profile.links.cv} class="btn">Download CV</a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .contact-motif {
    width: 8rem;
    margin: 0 auto 1rem;
    opacity: 0.5;
  }

  .contact-motif svg {
    stroke: var(--color-accent);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .contact-motif circle {
    fill: var(--color-accent);
    stroke: none;
  }

  .contact-inner {
    max-width: 42rem;
    margin-inline: auto;
  }

  .contact .section-lede {
    margin-inline: auto;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }
</style>
