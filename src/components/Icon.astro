---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={`icon-glyph ${className ?? ''}`}
  set:html={paths[name]}
/>

<style>
  .icon-glyph {
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
  }
</style>
