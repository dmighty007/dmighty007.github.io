---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';

const navItems = [
  { href: '/research', label: 'Research', icon: 'flask' as const },
  { href: '/publications', label: 'Publications', icon: 'file' as const },
  { href: '/software', label: 'Software', icon: 'code' as const },
  { href: '/about', label: 'About', icon: 'user' as const },
  { href: '/cv', label: 'CV', icon: 'clipboard' as const },
  { href: '/#contact', label: 'Contact', icon: 'mail' as const },
];

const currentPath = Astro.url.pathname;
---

<header class="site-nav" id="site-nav">
  <div class="container nav-inner">
    <a href="/" class="home-link" aria-label="Home" aria-current={currentPath === '/' ? 'page' : undefined}>
      <Icon name="home" size={18} />
    </a>
    <div class="nav-right">
      <nav aria-label="Primary" id="nav-links" class="nav-links">
      {
        navItems.map((item) => {
          const isActive = !item.href.includes('#') && currentPath === item.href;
          return (
            <a href={item.href} class:list={['nav-link', { 'is-active': isActive }]} aria-current={isActive ? 'page' : undefined}>
              <Icon name={item.icon} size={15} />
              {item.label}
            </a>
          );
        })
      }
      </nav>
      <div class="nav-controls">
        <ThemeToggle />
        <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">
          <span class="visually-hidden">Toggle navigation menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-standard), background-color var(--duration-base) var(--ease-standard);
  }

  .site-nav.is-scrolled {
    border-bottom-color: var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 96%, transparent);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.9rem;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 6px;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard);
  }

  .home-link:hover,
  .home-link[aria-current='page'] {
    color: var(--color-accent);
    background: var(--color-bg-raised);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    padding-block: 0.35rem;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .nav-link :global(.icon-glyph) {
    opacity: 0.75;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .nav-link:hover :global(.icon-glyph),
  .nav-link.is-active :global(.icon-glyph) {
    opacity: 1;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1.5px;
    background: var(--color-accent);
    transition: right var(--duration-base) var(--ease-standard);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-text);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    right: 0;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    cursor: pointer;
    position: relative;
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 25%;
    right: 25%;
    height: 1.5px;
    background: var(--color-text);
    transition: transform var(--duration-fast) var(--ease-standard), opacity var(--duration-fast) var(--ease-standard);
  }

  .nav-toggle-bars {
    top: 50%;
    transform: translateY(-50%);
  }

  .nav-toggle-bars::before {
    top: -6px;
  }

  .nav-toggle-bars::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars::before {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .nav-toggle {
      display: block;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--duration-base) var(--ease-standard);
    }

    .nav-links.is-open {
      max-height: 24rem;
    }

    .nav-link {
      width: 100%;
      padding: 0.85rem var(--gutter);
    }

    .nav-link::after {
      display: none;
    }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
