---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { educationFull } from '../data/education';
import { publications } from '../data/publications';
import { software } from '../data/software';
import { talks } from '../data/talks';
import { awards } from '../data/awards';
import { expertise } from '../data/expertise';

const academicAwards = awards.filter((a) => a.category === 'academic');

function highlightAuthor(authors: string): string {
  return authors.replace(/Dibyendu Maity/g, '<strong class="me">Dibyendu Maity</strong>');
}

function citationLine(pub: (typeof publications)[number]): string {
  const parts = [pub.venue];
  if (pub.volume) parts.push(pub.volume);
  if (pub.pages) parts.push(pub.pages);
  if (pub.articleNumber) parts.push(pub.articleNumber);
  return parts.join(', ');
}

const typeLabel: Record<string, string> = {
  invited: 'Invited lecture',
  lightning: 'Lightning talk',
  poster: 'Poster presentation',
};
---

<BaseLayout
  title="Curriculum Vitae — Dibyendu Maity"
  description="Web-based curriculum vitae for Dibyendu Maity: education, publications, scientific software, talks, awards, and technical expertise, with a downloadable PDF."
  path="/cv"
>
  <section class="cv-toolbar no-print">
    <div class="container cv-toolbar-inner">
      <div>
        <p class="eyebrow reveal">Curriculum Vitae</p>
        <h1 class="reveal">{profile.name}</h1>
      </div>
      <div class="cv-toolbar-actions reveal">
        <a href={profile.links.cv} class="btn btn-primary" download><Icon name="download" size={15} /> Download PDF</a>
        <button type="button" class="btn" id="print-cv"><Icon name="printer" size={15} /> Print this page</button>
      </div>
    </div>
  </section>

  <section class="cv-page-wrap">
    <div class="container">
      <article class="cv-sheet reveal">
        <header class="cv-doc-header">
          <h2>{profile.name}</h2>
          <p class="cv-doc-links">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <span aria-hidden="true">·</span>
            <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
            <span aria-hidden="true">·</span>
            <a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </p>
        </header>

        <section class="cv-doc-section">
          <h3>Research Profile</h3>
          {profile.longBio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="cv-doc-status">{profile.status}</p>
        </section>

        <section class="cv-doc-section">
          <h3>Education</h3>
          <div class="cv-doc-entries">
            {
              educationFull.map((entry) => (
                <div class="cv-doc-entry">
                  <div class="cv-doc-row">
                    <span class="cv-doc-title">{entry.degree}</span>
                    <span class="cv-doc-date">{entry.years}</span>
                  </div>
                  <p class="cv-doc-sub">{entry.institution}</p>
                  {entry.advisor && <p class="cv-doc-detail">Advisor: {entry.advisor}</p>}
                  {entry.detail && <p class="cv-doc-detail">{entry.detail}</p>}
                  {entry.status && <p class="cv-doc-detail cv-doc-status-line">{entry.status}</p>}
                </div>
              ))
            }
          </div>
        </section>

        <section class="cv-doc-section">
          <h3>Technical &amp; Computational Expertise</h3>
          <ul class="cv-doc-list">
            {
              expertise.map((group) => (
                <li>
                  <strong>{group.title}:</strong> {group.items.join(', ')}.
                </li>
              ))
            }
          </ul>
        </section>

        <section class="cv-doc-section">
          <h3>Scientific Software</h3>
          <ul class="cv-doc-list">
            {
              software.map((item) => (
                <li>
                  <strong>{item.name}</strong> ({item.language}). {item.description}{' '}
                  <a href={item.repo} target="_blank" rel="noopener noreferrer">
                    {item.repo.replace('https://', '')}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="cv-doc-section">
          <h3>Selected Publications</h3>
          <ol class="cv-doc-numbered">
            {
              publications.map((pub) => (
                <li>
                  <span set:html={highlightAuthor(pub.authors)} />. &ldquo;{pub.title}.&rdquo; <em>{citationLine(pub)}</em>
                  {pub.status === 'preprint' ? ' (preprint).' : '.'}{' '}
                  <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">
                    DOI: {pub.doi}
                  </a>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="cv-doc-section">
          <h3>Presentations &amp; Invited Talks</h3>
          <ol class="cv-doc-numbered">
            {
              talks.map((talk) => (
                <li>
                  <strong>{typeLabel[talk.type]}.</strong>{talk.title ? ` “${talk.title}.”` : ''} {talk.event}, {talk.place}, {talk.date}.
                  {talk.award && <strong class="cv-doc-award"> {talk.award}.</strong>}
                </li>
              ))
            }
          </ol>
        </section>

        <section class="cv-doc-section">
          <h3>Awards &amp; Recognition</h3>
          <ul class="cv-doc-list">
            {
              academicAwards.map((award) => (
                <li>
                  <strong>{award.title}</strong> — {award.issuer}, {award.year}.
                  {award.detail && ` ${award.detail}`}
                </li>
              ))
            }
          </ul>
        </section>

        <p class="cv-doc-footnote">Last updated August 2026. A downloadable PDF version is available above.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-toolbar {
    padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem;
  }

  .cv-toolbar-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .cv-toolbar h1 {
    font-size: clamp(1.8rem, 1.5rem + 1.2vw, 2.5rem);
    margin: 0.4rem 0 0.35rem;
  }

  .cv-toolbar-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cv-page-wrap {
    padding-block: 0 clamp(3rem, 8vw, 5rem);
  }

  /* --- The document itself: styled to read like a plain, dense,       */
  /* single-column printed academic CV rather than a site page. ------ */
  .cv-sheet {
    display: block;
    max-width: 54rem;
    margin-inline: auto;
    background: #fffefb;
    color: #1a1a1a;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 0.8125rem;
    line-height: 1.5;
    padding: clamp(1.75rem, 5vw, 3.25rem);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    box-shadow: 0 24px 48px -32px rgba(28, 33, 40, 0.28);
  }

  :root[data-theme='dark'] .cv-sheet {
    background: #fffefb;
    color: #1a1a1a;
  }

  .cv-doc-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1.1rem;
  }

  .cv-doc-header h2 {
    font-family: inherit;
    font-size: 1.15rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .cv-doc-links {
    margin: 0;
    font-size: 0.75rem;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .cv-doc-links a {
    color: #1155cc;
    text-decoration: none;
  }

  .cv-doc-links a:hover {
    text-decoration: underline;
  }

  .cv-doc-section {
    margin-bottom: 1.1rem;
  }

  .cv-doc-section h3 {
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-align: center;
    color: #1a1a1a;
    margin: 0 0 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid #1a1a1a;
  }

  .cv-doc-section p {
    margin: 0 0 0.55rem;
  }

  .cv-doc-status {
    font-weight: 700;
  }

  .cv-doc-entries {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cv-doc-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-weight: 700;
  }

  .cv-doc-date {
    white-space: nowrap;
    font-weight: 700;
  }

  .cv-doc-sub {
    font-style: italic;
    margin: 0.15rem 0 0;
  }

  .cv-doc-detail {
    margin: 0.1rem 0 0;
    font-size: 0.78rem;
  }

  .cv-doc-status-line {
    font-weight: 700;
    font-style: normal;
  }

  .cv-doc-list {
    list-style: disc;
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cv-doc-numbered {
    list-style: decimal;
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .cv-doc-numbered li,
  .cv-doc-list li {
    padding-left: 0.15rem;
  }

  .cv-doc-numbered :global(.me) {
    font-weight: 700;
  }

  .cv-doc-numbered a,
  .cv-doc-list a {
    color: #1155cc;
    text-decoration: none;
    word-break: break-word;
  }

  .cv-doc-numbered a:hover,
  .cv-doc-list a:hover {
    text-decoration: underline;
  }

  .cv-doc-award {
    font-style: italic;
  }

  .cv-doc-footnote {
    margin-top: 1.5rem;
    font-size: 0.7rem;
    color: #555;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .cv-doc-row {
      flex-direction: column;
      gap: 0.15rem;
    }
  }

  @media print {
    .cv-page-wrap {
      padding: 0;
    }

    .cv-sheet {
      max-width: none;
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0;
    }
  }
</style>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>
