---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import TalksAwards from '../components/TalksAwards.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { profile } from '../data/profile';
import { educationFull } from '../data/education';
---

<BaseLayout
  title="About — Dibyendu Maity"
  description="Biography, complete education record, technical expertise, talks, and awards for Dibyendu Maity, a computational biophysics researcher."
  path="/about"
>
  <section class="about-hero">
    <div class="container">
      <div class="about-text">
        <p class="eyebrow reveal">About</p>
        <h1 class="reveal">{profile.name}</h1>

        <figure class="about-portrait reveal">
          <div class="about-portrait-frame">
            <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="480" height="640" loading="eager" />
          </div>
          <figcaption>{profile.location}</figcaption>
        </figure>

        {profile.longBio.map((paragraph, i) => (
          <p class="about-bio reveal" style={`transition-delay:${i * 60}ms`}>{paragraph}</p>
        ))}
        <p class="about-status reveal">{profile.status}</p>
        <p class="about-interests reveal">
          <span class="about-interests-label">Research interests</span>
          {profile.interests.join(' · ')}
        </p>
        <div class="about-clear"></div>
      </div>
    </div>
  </section>

  <Timeline full entries={educationFull} />
  <ExpertiseSection />
  <TalksAwards />
  <ContactSection />
</BaseLayout>

<style>
  .about-hero {
    padding-block: clamp(2.5rem, 6vw, 4rem) 1rem;
  }

  .about-text {
    max-width: 50rem;
  }

  .about-text h1 {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    margin: 0.5rem 0 1.5rem;
  }

  .about-bio {
    color: var(--color-text-secondary);
    max-width: 66ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    margin-bottom: 1.1rem;
  }

  .about-status {
    clear: both;
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .about-interests {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    max-width: 60ch;
  }

  .about-interests-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.4rem;
  }

  .about-portrait {
    float: right;
    margin: 0.25rem 0 1.25rem 2rem;
    width: 45%;
    max-width: 14rem;
  }

  .about-clear {
    clear: both;
  }

  .about-portrait-frame {
    position: relative;
    isolation: isolate;
  }

  .about-portrait-frame::before {
    content: '';
    position: absolute;
    inset: 0.65rem -0.65rem -0.65rem 0.65rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 10px;
    opacity: 0.55;
    z-index: -1;
  }

  .about-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 32px -18px rgba(28, 33, 40, 0.35);
    filter: grayscale(8%) saturate(1.02) contrast(1.03);
  }

  .about-portrait figcaption {
    margin-top: 1.1rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.02em;
  }

  @media (max-width: 560px) {
    .about-portrait {
      float: none;
      width: 100%;
      max-width: 13rem;
      margin: 0 auto 1.75rem;
    }
  }
</style>
